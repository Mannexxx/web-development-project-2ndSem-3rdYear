# Uploaded photos are images only: never run scripts from this folder
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|phar|php[0-9])$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
